{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "delayRange": {
      "type": "object",
      "properties": {
        "min": { "type": "number", "minimum": 0.0, "maximum": 15.0 },
        "max": { "type": "number", "minimum": 0.0, "maximum": 15.0 }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "log_level",
    "locale",
    "game_url",
    "majsoul_server",
    "platform",
    "mitm",
    "server",
    "ot",
    "model_config"
  ],
  "properties": {
    "log_level": {
      "type": "string",
      "enum": ["TRACE", "DEBUG", "INFO", "WARNING", "ERROR"],
      "default": "INFO",
      "description": "Logging level."
    },
    "locale": {
      "type": "string",
      "enum": ["zh-CN", "zh-TW", "en-US", "ja-JP"],
      "default": "en-US",
      "description": "UI Language locale."
    },
    "game_url": {
      "type": "string",
      "default": "https://game.maj-soul.com/1/",
      "readOnly": true,
      "description": "Backend-derived game URL for internal Electron window."
    },
    "majsoul_server": {
      "type": "string",
      "enum": ["cn", "jp", "en"],
      "default": "cn",
      "description": "Majsoul server used to derive the game URL."
    },
    "platform": {
      "type": "string",
      "enum": ["auto", "majsoul", "tenhou", "amatsuki", "riichi_city"],
      "default": "majsoul",
      "description": "The target mahjong platform."
    },
    "mitm": {
      "type": "object",
      "description": "MITM proxy configuration.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable MITM proxy."
        },
        "host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "MITM proxy listening host."
        },
        "port": {
          "type": "integer",
          "default": 6789,
          "minimum": 1024,
          "maximum": 65535,
          "description": "MITM proxy listening port."
        },
        "upstream": {
          "type": "string",
          "default": "",
          "description": "Upstream proxy URL (e.g. http://127.0.0.1:7890)."
        }
      },
      "required": ["enabled", "host", "port", "upstream"],
      "additionalProperties": false
    },
    "mihomo": {
      "type": "object",
      "description": "Bundled mihomo TUN core configuration. Optional for backward compatibility.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Start the bundled mihomo core with Akagi-NG."
        },
        "mixed_port": {
          "type": "integer",
          "default": 7890,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Local mixed proxy port exposed by mihomo."
        },
        "controller_port": {
          "type": "integer",
          "default": 9090,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Loopback-only mihomo controller port."
        },
        "strict_route": {
          "type": "boolean",
          "default": false,
          "description": "Enable strict TUN routing. This can conflict with virtualization software on Windows."
        }
      },
      "required": ["enabled", "mixed_port", "controller_port", "strict_route"],
      "additionalProperties": false
    },
    "desktop": {
      "type": "object",
      "description": "Desktop overlay and privacy behavior. Optional for backward compatibility.",
      "properties": {
        "overlay_mode": {
          "type": "string",
          "enum": ["standard", "advanced"],
          "default": "standard"
        },
        "advanced_host": {
          "type": "string",
          "enum": ["auto", "discord", "protected"],
          "default": "auto"
        },
        "capture_protection": {
          "type": "boolean",
          "default": true
        },
        "privacy_mode": {
          "type": "boolean",
          "default": false
        },
        "tray_visible": {
          "type": "boolean",
          "default": true
        },
        "start_hidden": {
          "type": "boolean",
          "default": false
        },
        "restore_shortcut": {
          "type": "string",
          "minLength": 1,
          "default": "CommandOrControl+Shift+A"
        }
      },
      "required": [
        "overlay_mode",
        "advanced_host",
        "capture_protection",
        "privacy_mode",
        "tray_visible",
        "start_hidden",
        "restore_shortcut"
      ],
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "description": "Data server configuration.",
      "properties": {
        "host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Server listening host."
        },
        "port": {
          "type": "integer",
          "default": 8765,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Server listening port."
        }
      },
      "required": ["host", "port"],
      "additionalProperties": false
    },
    "ot": {
      "description": "Online service configuration.",
      "type": "object",
      "properties": {
        "online": {
          "type": "boolean",
          "description": "Whether to use the online service.",
          "default": false
        },
        "provider": {
          "type": "string",
          "enum": ["akagi_ot3", "flya_test_api"],
          "default": "akagi_ot3"
        },
        "server": {
          "type": "string",
          "description": "The server URL for the online service.",
          "default": ""
        },
        "api_key": {
          "type": "string",
          "description": "The API key for the online service.",
          "default": ""
        },
        "protocol": {
          "type": "string",
          "enum": ["v3", "legacy"],
          "description": "Online inference API protocol. OT3 uses v3.",
          "default": "v3"
        },
        "model_4p": {
          "type": "string",
          "description": "Optional OT3 four-player model id; empty uses the server default.",
          "default": ""
        },
        "model_3p": {
          "type": "string",
          "description": "Optional OT3 three-player model id; empty uses the server default.",
          "default": ""
        },
        "flya_server": {
          "type": "string",
          "description": "The server URL for the FlyA test API.",
          "default": "https://api.nashout.com"
        },
        "flya_api_key": {
          "type": "string",
          "description": "A write-only FlyA test API key.",
          "default": ""
        },
        "flya_api_key_configured": {
          "type": "boolean",
          "description": "Whether a FlyA API key is stored in Windows DPAPI.",
          "default": false
        },
        "flya_api_key_last4": {
          "type": "string",
          "maxLength": 4,
          "default": ""
        },
        "flya_model_4p": {
          "type": "string",
          "default": ""
        },
        "flya_model_3p": {
          "type": "string",
          "default": ""
        },
        "proxy_enabled": {
          "type": "boolean",
          "description": "Route every OT3 request through the configured proxy.",
          "default": false
        },
        "proxy": {
          "type": "string",
          "description": "OT3 proxy URL using HTTP, HTTPS, SOCKS5, or SOCKS5H.",
          "default": "",
          "pattern": "^(|(?:http|https|socks5|socks5h)://.+)$"
        }
      },
      "required": ["online"],
      "if": {
        "properties": {
          "online": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["server", "api_key"],
        "properties": {
          "server": {
            "minLength": 1,
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    },
    "model_config": {
      "type": "object",
      "description": "AI model configuration.",
      "properties": {
        "model_4p": {
          "type": "string",
          "default": "mortal.pth",
          "description": "Selected model for 4-player mahjong."
        },
        "model_3p": {
          "type": "string",
          "default": "mortal3p.pth",
          "description": "Selected model for 3-player mahjong."
        },
        "temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0.1,
          "maximum": 1.3,
          "description": "Softmax temperature for model confidence normalization."
        }
      },
      "required": [
        "model_4p",
        "model_3p",
        "temperature"
      ],
      "additionalProperties": false
    },
    "autoplay": {
      "type": "object",
      "description": "Autoplay configuration. Optional for backward compatibility.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable automatic in-game actions."
        },
        "window_keyword": {
          "type": "string",
          "default": "",
          "description": "Optional custom window title keyword used to locate the target game window."
        },
        "delay_mode": {
          "type": "string",
          "enum": ["human", "advanced", "lua", "legacy"],
          "default": "human",
          "description": "Built-in humanized or per-action advanced autoplay timing. Lua and legacy values are accepted only for migration."
        },
        "timing": {
          "description": "Built-in timing bounds. The second branch accepts pre-range settings for migration.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "first_discard": { "$ref": "#/definitions/delayRange" },
                "discard": { "$ref": "#/definitions/delayRange" },
                "button": { "$ref": "#/definitions/delayRange" },
                "candidate": { "$ref": "#/definitions/delayRange" }
              },
              "required": ["first_discard", "discard", "button", "candidate"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "first_tile": { "type": "number", "minimum": 0.0, "maximum": 15.0 },
                "rand_min": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
                "rand_max": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
                "candidate": { "type": "number", "minimum": 0.0, "maximum": 5.0 }
              },
              "required": ["first_tile", "rand_min", "rand_max", "candidate"],
              "additionalProperties": false
            }
          ]
        },
        "advanced_timing": {
          "type": "object",
          "description": "Independent delay bounds for every supported autoplay action.",
          "properties": {
            "first_discard": { "$ref": "#/definitions/delayRange" },
            "discard": { "$ref": "#/definitions/delayRange" },
            "tsumogiri": { "$ref": "#/definitions/delayRange" },
            "reach": { "$ref": "#/definitions/delayRange" },
            "reach_discard": { "$ref": "#/definitions/delayRange" },
            "chi": { "$ref": "#/definitions/delayRange" },
            "pon": { "$ref": "#/definitions/delayRange" },
            "daiminkan": { "$ref": "#/definitions/delayRange" },
            "ankan": { "$ref": "#/definitions/delayRange" },
            "kakan": { "$ref": "#/definitions/delayRange" },
            "ron": { "$ref": "#/definitions/delayRange" },
            "tsumo": { "$ref": "#/definitions/delayRange" },
            "ryukyoku": { "$ref": "#/definitions/delayRange" },
            "nukidora": { "$ref": "#/definitions/delayRange" },
            "skip": { "$ref": "#/definitions/delayRange" },
            "candidate": { "$ref": "#/definitions/delayRange" }
          },
          "required": [
            "first_discard", "discard", "tsumogiri", "reach", "reach_discard", "chi", "pon",
            "daiminkan", "ankan", "kakan", "ron", "tsumo", "ryukyoku", "nukidora", "skip", "candidate"
          ],
          "additionalProperties": false
        },
        "input": {
          "type": "object",
          "description": "Mouse path tuning for autoplay input.",
          "properties": {
            "bezier_smoothing": {
              "type": "number",
              "default": 0.35,
              "minimum": 0.0,
              "maximum": 1.0
            },
            "bezier_steps": {
              "type": "integer",
              "default": 18,
              "minimum": 6,
              "maximum": 64
            }
          },
          "required": ["bezier_smoothing", "bezier_steps"],
          "additionalProperties": false
        },
        "auto_join": {
          "type": "object",
          "description": "Automatically join a selected Mahjong Soul ranked room and match mode after a game ends.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "room": {
              "type": "string",
              "enum": ["copper", "silver", "gold", "jade", "throne"],
              "default": "gold"
            },
            "mode": {
              "type": "string",
              "enum": ["four_east", "four_south", "three_east", "three_south"],
              "default": "four_south"
            },
            "result_delay": {
              "type": "number",
              "default": 10.0,
              "minimum": 5.0,
              "maximum": 60.0
            }
          },
          "required": ["enabled", "room", "mode", "result_delay"],
          "additionalProperties": false
        }
      },
      "required": ["enabled", "window_keyword", "timing", "input"],
      "additionalProperties": false
    }
  },
  "description": "Settings for the application.",
  "additionalProperties": false
}
